-  --sigil-red: #8c2f2f;          /* Wax-seal red — alerts, violations, reverts */
-  --sigil-red-light: rgba(140, 47, 47, 0.2);
-
-  /* Radius — Small and consistent, not zero, not soft */
-  --radius: 3px;
-
-  /* Typography Variables */
-  --font-serif: 'Fraunces', Georgia, serif;
-  --font-ui: 'Plus Jakarta Sans', -apple-system, sans-serif;
-  --font-mono: 'JetBrains Mono', Courier, monospace;
-
-  /* Legacy & Compatibility Aliases */
-  --steel: var(--bg-well);
-  --concrete: var(--bg-folio);
-  --concrete-dark: var(--bg-well);
-  --ink-hard: var(--ink);
-  --ink-soft: var(--ink-secondary);
-  --recovered-mark: var(--verdigris);
-  --at-risk-accent: var(--gold-leaf);
-  --critical-accent: var(--sigil-red);
-  --signal-accent: var(--gold-leaf);
-  --arc-purple: var(--porphyry);
-  --yield-green: var(--verdigris);
-  --gold-amber: var(--gold-leaf);
-  --signal-red: var(--sigil-red);
-  --cyan-blue: var(--gold-leaf);
-  --border-color: var(--rule-hairline);
-  --shadow-sm: none;
-  --shadow-md: none;
-  --shadow-lg: none;
-}
