-/* ==========================================================================
-   SAKELLARIOYS (SAKELLARIOS) — BYZANTINE LEDGER EDITORIAL DESIGN SYSTEM
-   Version: 1.0.0
-   Design Paradigm: Byzantine Manuscript Ledger Editorial ("The Ledger, Not the Machine")
-   Theme: data-theme="ledger" (Iron-Gall Dark) | data-theme="parchment" (Vellum Light)
-   ========================================================================== */
-
-@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');
-
-:root, [data-theme="ledger"] {
-  /* Grounds — Warm Iron-Gall Ink & Manuscript Folios */
-  --bg-page: #0b0a08;            /* Near-black iron-gall, warm not cold */
-  --bg-folio: #141210;           /* Chapter/section surface */
-  --bg-well: #1c1916;            /* Recessed fields, tables */
-  --bg-parchment: #f3ead9;       /* Light-mode ground reference */
-
-  /* Structural lines — Hairline precision, not heavy offset */
-  --rule-hairline: rgba(243, 234, 217, 0.14);
-  --rule-bright: rgba(243, 234, 217, 0.32);
-
-  /* Inks */
-  --ink: #f3ead9;                /* Primary text — warm parchment white */
-  --ink-secondary: #b8ab93;      /* Secondary labels */
-  --ink-faint: #756a57;          /* Captions, metadata, folio numbers */
-
-  /* Imperial Accents — Reserved, never decorative */
