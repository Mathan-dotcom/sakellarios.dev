-/* ==========================================================================
-   RESET & FOUNDATIONS
-   ========================================================================== */
-*, *::before, *::after {
-  box-sizing: border-box;
-  margin: 0;
-  padding: 0;
-}
-
-html {
-  font-size: 16px;
-  background-color: var(--bg-page);
-  color: var(--ink);
-  font-family: var(--font-ui);
-  text-rendering: geometricPrecision;
-  -webkit-font-smoothing: antialiased;
-  scroll-behavior: smooth;
-}
-
-body {
-  min-height: 100vh;
-  background-color: var(--bg-page);
-  color: var(--ink);
-  position: relative;
-  overflow-x: hidden;
-  transition: background-color 0.25s ease, color 0.25s ease;
-}
-
-/* ==========================================================================
-   AMBIENT LIVING LEDGER WALLPAPER (§6)
-   Fixed background canvas that stays behind all page content
-   ========================================================================== */
-#sak-wallpaper {
-  position: fixed;
-  top: 0;
-  left: 0;
-  width: 100vw;
-  height: 100vh;
-  z-index: 0;
-  pointer-events: none;
-  opacity: 0.85;
-}
-
-#app {
-  position: relative;
-  z-index: 1;
-  min-height: 100vh;
-  background: transparent;
-}
-
-::selection {
-  background: var(--porphyry);
-  color: #ffffff;
-}
-
-:focus-visible {
-  outline: 1.5px solid var(--gold-leaf);
-  outline-offset: 2px;
-}
-
-/* ==========================================================================
-   TYPOGRAPHY HIERARCHY (§3)
-   ========================================================================== */
-.text-folio-title {
-  font-family: var(--font-serif);
-  font-size: clamp(2.2rem, 5vw, 4rem);
-  line-height: 1.05;
-  font-weight: 480;
-  letter-spacing: -0.02em;
-  color: var(--ink);
-}
-
-.text-display {
-  font-family: var(--font-serif);
-  font-size: clamp(1.5rem, 3vw, 2.2rem);
-  line-height: 1.15;
-  font-weight: 440;
-  color: var(--ink);
-}
-
-.text-heading {
-  font-family: var(--font-ui);
-  font-size: 0.95rem;
-  line-height: 1.3;
-  font-weight: 600;
-  text-transform: uppercase;
-  letter-spacing: 0.06em;
-  color: var(--ink);
-}
-
-.text-body {
-  font-family: var(--font-ui);
-  font-size: 0.95rem;
-  line-height: 1.6;
-  font-weight: 400;
-  color: var(--ink-secondary);
-}
-
-.text-ledger {
-  font-family: var(--font-mono);
-  font-size: 0.85rem;
-  line-height: 1.4;
-  font-weight: 500;
-  font-variant-numeric: tabular-nums;
-  color: var(--ink);
-}
-
-.text-folio-number {
-  font-family: var(--font-mono);
-  font-size: 0.75rem;
-  line-height: 1.2;
-  font-weight: 600;
-  text-transform: uppercase;
-  letter-spacing: 0.1em;
-  color: var(--gold-leaf);
-}
-
-/* ==========================================================================
-   CHANCERY SEAL BADGES (§5.2) — Replaces Rubber Stamps
-   ========================================================================== */
-.sak-seal {
-  display: inline-flex;
-  align-items: center;
-  gap: 6px;
-  border: 1px solid var(--rule-bright);
-  border-radius: 999px;
-  padding: 4px 12px;
-  font-family: var(--font-mono);
-  font-size: 0.7rem;
-  letter-spacing: 0.08em;
-  color: var(--gold-leaf);
-  background: transparent;
-  user-select: none;
-  transition: all 0.2s ease;
-}
-
-.sak-seal--porphyry {
-  color: #ffffff;
-  background: var(--porphyry);
-  border-color: var(--porphyry);
-}
-
-.sak-seal--settled, .bru-stamp--success {
-  color: var(--verdigris);
-  border-color: var(--verdigris);
-  background: var(--verdigris-light);
-}
-
-.sak-seal--warning, .bru-stamp--warning {
-  color: var(--gold-leaf);
-  border-color: var(--gold-leaf);
-  background: var(--gold-leaf-light);
-}
-
-.sak-seal--violation, .bru-stamp--critical {
-  color: var(--sigil-red);
-  border-color: var(--sigil-red);
-  background: var(--sigil-red-light);
-}
-
-/* Compatibility alias for existing bru-stamp elements */
-.bru-stamp {
-  display: inline-flex;
-  align-items: center;
-  gap: 6px;
-  border: 1px solid var(--rule-bright);
-  border-radius: 999px;
-  padding: 4px 12px;
-  font-family: var(--font-mono);
-  font-size: 0.7rem;
-  letter-spacing: 0.08em;
-  color: var(--gold-leaf);
-  background: transparent;
-}
-
-.bru-stamp--inverted {
-  color: var(--ink);
-  border-color: var(--rule-bright);
-}
-
-.bru-stamp--cyan, .bru-stamp--purple {
-  color: var(--gold-leaf);
-  border-color: var(--rule-bright);
-}
-
-/* ==========================================================================
-   PRIMARY BUTTONS (§5.1) — Hairline Editorial Shift
-   ========================================================================== */
-.sak-btn, .bru-button, .bru-btn {
-  display: inline-flex;
-  align-items: center;
-  justify-content: center;
-  gap: 8px;
-  background: transparent;
-  border: 1px solid var(--rule-bright);
-  border-radius: var(--radius);
-  color: var(--ink);
-  font-family: var(--font-ui);
-  font-size: 0.85rem;
-  font-weight: 500;
-  letter-spacing: 0.03em;
-  padding: 10px 20px;
-  cursor: pointer;
-  text-decoration: none;
-  user-select: none;
-  box-shadow: none;
-  transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
-}
-
-.sak-btn:hover, .bru-button:hover, .bru-btn:hover {
-  border-color: var(--gold-leaf);
-  background: rgba(201, 162, 75, 0.08);
-  color: var(--ink);
-  transform: none;
-  box-shadow: none;
-}
-
-.sak-btn:active, .bru-button:active, .bru-btn:active {
-  background: rgba(201, 162, 75, 0.16);
-  transform: none !important;
-}
-
-.sak-btn--primary, .bru-button-primary, .bru-btn-primary {
-  background: var(--porphyry);
-  border-color: var(--porphyry);
-  color: #f3ead9;
-  font-weight: 600;
-}
-
-.sak-btn--primary:hover, .bru-button-primary:hover, .bru-btn-primary:hover {
-  background: #6e3384;
-  border-color: #6e3384;
-  color: #ffffff;
-  transform: none;
-  box-shadow: none;
-}
-
-.sak-btn--settled, .bru-button-success {
-  background: var(--verdigris-light);
-  border-color: var(--verdigris);
-  color: var(--verdigris);
-  font-weight: 600;
-}
-
-.sak-btn--settled:hover, .bru-button-success:hover {
-  background: rgba(79, 138, 124, 0.25);
-  border-color: var(--verdigris);
-  color: #ffffff;
-}
-
-.sak-btn--danger, .bru-button-danger {
-  background: var(--sigil-red-light);
-  border-color: var(--sigil-red);
-  color: var(--sigil-red);
-}
-
-.sak-btn--danger:hover, .bru-button-danger:hover {
-  background: rgba(140, 47, 47, 0.3);
-  color: #ffffff;
-}
-
-.bru-button-sm {
-  padding: 6px 12px;
-  font-size: 0.75rem;
-}
-
-/* Inputs */
-.sak-input, .bru-input {
-  background: var(--bg-well);
-  border: 1px solid var(--rule-hairline);
-  border-radius: var(--radius);
-  color: var(--ink);
-  font-family: var(--font-mono);
-  font-size: 0.85rem;
-  padding: 10px 14px;
-  width: 100%;
-  transition: border-color 0.2s ease, background 0.2s ease;
-}
-
-.sak-input:focus, .bru-input:focus {
-  border-color: var(--gold-leaf);
-  outline: none;
-  background: var(--bg-folio);
-}
-
-/* ==========================================================================
-   MARQUEE SCRIBE RUNNING ANNOTATION (§4.1)
-   ========================================================================== */
-.sak-marquee {
-  overflow: hidden;
-  white-space: nowrap;
-  border-top: 1px solid var(--rule-hairline);
-  border-bottom: 1px solid var(--rule-hairline);
-  font-family: var(--font-mono);
-  font-size: 0.72rem;
-  letter-spacing: 0.12em;
-  color: var(--ink-faint);
-  padding: 12px 0;
-  user-select: none;
-  background: var(--bg-page);
-}
-
-.sak-marquee-track {
-  display: inline-flex;
-  animation: sak-scroll 45s linear infinite;
-}
-
-.sak-marquee-item {
-  display: inline-flex;
-  align-items: center;
-  gap: 1.5rem;
-  padding: 0 1.5rem;
-}
-
-.sak-marquee-sep {
-  color: var(--gold-leaf);
-  opacity: 0.6;
-}
-
-@keyframes sak-scroll {
-  from { transform: translateX(0); }
-  to   { transform: translateX(-50%); }
-}
-
-/* Cursor Blink */
-@keyframes cursorBlink {
-  0%, 49% { opacity: 1; }
-  50%, 100% { opacity: 0; }
-}
-
-.anim-cursor {
-  display: inline-block;
-  font-family: var(--font-mono);
-  animation: cursorBlink 0.9s steps(1) infinite;
-  color: var(--gold-leaf);
-}
